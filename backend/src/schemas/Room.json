{
  "fields": {
    "name": {
      "type": "String",
      "description": "Room name (optional)"
    },
 "code": {
  "type": "String",
  "required": true,
  "unique": true,
  "description": "6-digit room code"
},
    "host": {
      "type": "ObjectId",
      "ref": "User",
      "required": true
    },
    "players": {
      "type": "Object",
      "required": true,
      "properties": {
        "white": {
          "type": "Object",
          "properties": {
            "userId":   { "type": "ObjectId", "ref": "User" },
            "socketId": { "type": "String" }
          }
        },
        "black": {
          "type": "Object",
          "properties": {
            "userId":   { "type": "ObjectId", "ref": "User" },
            "socketId": { "type": "String" }
          }
        }
      }
    },
    "gameId": {
      "type": "ObjectId",
      "ref": "Game"
    },
    "status": {
      "type": "String",
      "enum": ["waiting", "full", "in_game", "closed"],
      "default": "waiting"
    },
    "expiresAt": {
      "type": "Date"
    }
  },
  "useFieldsFrom": ["detail"],
  "behaviors": ["generateRoomCode", "preSave"]
}